{
  "compilerOptions": {
    "target": "ES2023",
    // Sem "dom" e sem os tipos do Node: fetch, window e process nem existem aqui.
    // É assim que o núcleo fica sem rede (CLAUDE.md, "Núcleo puro").
    "lib": ["ES2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
